# Пример переменных окружения. Реальные значения — только в GitHub Secrets / Variables
# (Settings → Secrets and variables → Actions) или в локальном .env (он в .gitignore). Ключей в репозитории нет.

# Секрет: ключ API Яндекс Wordstat. Без него спрос не обновляется (честно «нет данных»).
WORDSTAT_TOKEN=

# Переменная (не секрет): идентификатор каталога Yandex Cloud для Wordstat API.
WORDSTAT_FOLDER_ID=

# Необязательно: адрес API, схема заголовка Authorization, id региона Wordstat (65 — Новосибирская область).
# WORDSTAT_API_URL=https://searchapi.api.cloud.yandex.net/v2/wordstat
# WORDSTAT_AUTH_SCHEME=Api-Key
# WORDSTAT_REGION=65

# Только для сухих прогонов скриптов: каталог данных и подмена адреса ЦБ.
# DATA_DIR=/tmp/data-copy
# CBR_URL=http://127.0.0.1:8091/ok
